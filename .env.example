# Token del bot de Telegram (guárdalo como variable secreta en Vercel)
TELEGRAM_BOT_TOKEN="pon-aqui-el-token-de-tu-bot"

# URL pública de tu aplicación (para webhooks y redirecciones)
APP_URL="https://tu-dominio.vercel.app"

# ID del chat de Telegram donde la agencia recibirá avisos de nuevas compras
ADMIN_TELEGRAM_CHAT_ID="123456789"

# Solo para desarrollo local. En Vercel se usa una base de datos Postgres gestionada.
DATABASE_PATH="./data/orders.sqlite"

# La integración de Neon en Vercel configura esta variable automáticamente.
# Para desarrollo local, puedes poner aquí la URL de conexión de Neon.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
